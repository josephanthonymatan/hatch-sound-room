# Copy to .env, chmod 600 .env, and edit locally. Never commit the real file.
HATCH_EMAIL=
HATCH_PASSWORD=
# Generate independently for this install: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
API_TOKEN=
# Optional independent cookie signing secret; at least 32 random characters.
# SESSION_SECRET=
PUBLIC_ORIGIN=http://127.0.0.1:3001
# For local audio, set this to this server's LAN URL reachable from the Hatch.
# AUDIO_ORIGIN=http://YOUR_LAN_ADDRESS:3001
OWNER_NAME=Owner
DATA_DIR=./data
PORT=3001
